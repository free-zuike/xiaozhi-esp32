{
    "type": "phone-av",
    "target": "esp32s3",
    "builds": [
        {
            "name": "phone-av",
            "sdkconfig_append": [
                "CONFIG_FLASH_DEFAULT_ASSETS=n",
                "CONFIG_FLASH_CUSTOM_ASSETS=n",
                "CONFIG_FLASH_EXPRESSION_ASSETS=n",
                "CONFIG_FLASH_NONE_ASSETS=y",
                "CONFIG_MQTT_USE_CUSTOM_CONFIG=y",
                "CONFIG_MQTT_TASK_STACK_SIZE=10240"
            ]
        }
    ]
}
